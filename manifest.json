{
  "update_url": "https://clients2.google.com/service/update2/crx",
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_appName__",
  "version": "4.2.0",
  "description": "__MSG_description__",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "scripting",
    "activeTab",
    "declarativeNetRequest",
    "storage",
    "notifications",
    "tabCapture",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://localhost/*",
    "https://localhost/*",
    "http://127.0.0.1/*",
    "https://127.0.0.1/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*.png",
        "icons/frames/*.png",
        "recorder.html",
        "media/robot/*.webp",
        "media/robot/*.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_title": "__MSG_actionTitle__"
  }
}